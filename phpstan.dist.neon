# Rozszerzenia dołączone ręcznie zamiast przez wtyczkę phpstan/extension-installer.
includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    # Poziom 9+ wymaga typowania wyników DQL (objectManagerLoader) w repozytoriach.
    level: 8
    paths:
        - src
        - tests
        - tools
    excludePaths:
        analyse:
            # Przykłady naruszeń dla testów reguł z tools/PHPStan.
            - tests/Tools/PHPStan/data
    tmpDir: var/cache/phpstan
    symfony:
        # Kontener kompiluje `lint:container`, które `composer check` uruchamia wcześniej.
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        # Formularze wiążą się wprost z encjami: pole wymagane jest null, dopóki
        # walidacja (NotBlank/NotNull) nie potwierdzi wartości przed zapisem.
        allowNullablePropertyForRequiredField: true

# Reguły projektu (tools/PHPStan), testowane w tests/Tools/PHPStan.
rules:
    - App\Tools\PHPStan\NoImplicitNowRule
    - App\Tools\PHPStan\HttpOnlyTestsRule
