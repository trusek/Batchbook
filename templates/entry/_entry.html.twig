{#
    Jeden wpis w dzienniku, w ramce Turbo "entry-<id>". „Edytuj” ładuje do tej ramki formularz
    (entry/_edit_form.html.twig); „Usuń” odświeża ramkę "journal" ze strony nastawu.
#}
{% set future = entry is future %}
<turbo-frame id="entry-{{ entry.id }}">
    <article data-entry{% if future %} data-entry-future class="entry-future"{% endif %}>
        <header>
            <time data-entry-occurred-at datetime="{{ entry.occurredAt|date('Y-m-d\\TH:i') }}">{{ entry.occurredAt|date('d.m.Y H:i') }}</time>
            {% if future %}<small>· zaplanowany</small>{% endif %}
        </header>
        <p data-entry-note>{{ entry.note|nl2br }}</p>
        <footer class="entry-actions">
            <a href="{{ path('entry_edit', {id: entry.id}) }}">Edytuj</a>
            {{ include('_delete_form.html.twig', {
                action: path('entry_delete', {id: entry.id}),
                message: 'Usunąć ten wpis?',
                frame: 'journal',
            }) }}
        </footer>
    </article>
</turbo-frame>
