<!DOCTYPE html>
<html lang="pl">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="light dark">
        <title>{% block title %}Dziennik nastawów{% endblock %} · Dziennik nastawów</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🍷</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {# Układ „Notatnik”: pasek boczny z nastawami na każdej stronie + treść.
           Link pomijający pasek jest pierwszym elementem strony (WCAG 2.4.1). #}
        <a class="skip-link" href="#tresc">Przejdź do treści</a>
        <div class="shell">
            {# Strony nastawu (podgląd, edycja) przekazują `batch`: ten nastaw jest zaznaczony w pasku. #}
            {{ include('_sidebar.html.twig', {current: batch ?? null}) }}
            <main class="content" id="tresc" tabindex="-1">
                {% block body %}{% endblock %}
            </main>
        </div>
    </body>
</html>
