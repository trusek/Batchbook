{#
    Pole formularza bez widocznej etykiety, ale dostępne (WCAG 1.3.1, 3.3.2, 4.1.2): etykieta ukryta
    wizualnie (czytniki ją odczytają), aria-invalid przy błędzie i błędy powiązane przez aria-describedby
    (identyfikatory błędów jak w form_errors Symfony: <id>_error1, <id>_error2...).
    Używane w wierszach dziennika (szybki wpis, edycja wpisu), gdzie nagłówek kolumny zastępuje etykietę.

    Parametry: field, label, attr (opcjonalnie, dokładane do atrybutów pola).
#}
{% set errors = field.vars.errors %}
{% set aria = {} %}
{% if errors|length > 0 %}
    {% set aria = {'aria-invalid': 'true', 'aria-describedby': errors|map((_, i) => field.vars.id ~ '_error' ~ (i + 1))|join(' ')} %}
{% endif %}
{{ form_label(field, label, {label_attr: {class: 'sr-only'}}) }}
{{ form_widget(field, {attr: field.vars.attr|merge(attr|default({}))|merge(aria)}) }}
{{ form_errors(field) }}
